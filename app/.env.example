# --- Required — server refuses to start without these ---
DATABASE_URL=postgresql://user:password@localhost:5432/savivah
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_JWT_SECRET=change-this-to-a-DIFFERENT-long-random-string

PORT=8000
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# --- Redis (cache + rate limiting only, never authoritative) ---
REDIS_URL=redis://localhost:6379/0
PRODUCT_CACHE_TTL_SECONDS=30

# --- Pesapal ---
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=http://localhost:8000/api/payments/callback
PESAPAL_IPN_ID=

# --- Google sign-in ---
GOOGLE_CLIENT_ID=

# --- Fargo (webhook payload shape is still an assumption — see README) ---
FARGO_API_KEY=
FARGO_WEBHOOK_SECRET=
